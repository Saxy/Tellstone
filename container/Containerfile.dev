# Containerfile.dev — multi-stage build for local development.
# Used by `task podman:build`.

FROM golang:1.26-alpine AS build

RUN apk add --no-cache git gcc musl-dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

ARG VERSION=0.0.0-dev
ARG COMMIT=unknown
ARG DATE=unknown

# pg_query_go embeds the PostgreSQL C parser and needs cgo; link statically
# (musl) so the binary still runs on the distroless/static final stage.
RUN CGO_ENABLED=1 go build \
    -ldflags "-s -w -linkmode=external -extldflags=-static \
      -X github.com/Saxy/Tellstone/internal/version.Version=${VERSION} \
      -X github.com/Saxy/Tellstone/internal/version.Commit=${COMMIT} \
      -X github.com/Saxy/Tellstone/internal/version.Date=${DATE}" \
    -o /tellstone ./cmd/tellstone

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=build /tellstone /tellstone

ENV TSD_ADDR=0.0.0.0:9988

EXPOSE 9988

USER nonroot:nonroot

ENTRYPOINT ["/tellstone"]
