"SELECT version()"
"SELECT n.nspname FROM pg_catalog.pg_namespace n ORDER BY n.nspname"
"SELECT c.relname, n.nspname FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON c.relnamespace = n.oid ORDER BY 1, 2"
"SELECT table_schema, table_name FROM information_schema.tables WHERE table_schema = 'public' ORDER BY table_schema, table_name"
"SELECT column_name, data_type, is_nullable FROM information_schema.columns WHERE table_name = 'users' ORDER BY ordinal_position LIMIT 50"
"SELECT DISTINCT table_type FROM information_schema.tables"
"SELECT c.oid, c.relname FROM pg_catalog.pg_class c WHERE c.relkind = 'r' ORDER BY c.oid LIMIT 100 OFFSET 0"
"SELECT d.objoid, d.description FROM pg_catalog.pg_description d ORDER BY d.objoid LIMIT 10"
"SET timezone TO 'UTC'"
"SET search_path TO public"
"CREATE TABLE dg (id bigint PRIMARY KEY, v text)"
"INSERT INTO dg (id, v) VALUES (2, 'two')"
"INSERT INTO dg (id, v) VALUES (1, 'one')"
"INSERT INTO dg (id, v) VALUES (3, 'three')"
"SELECT id AS object_id, v AS object_name FROM dg ORDER BY object_name DESC"
"SELECT DISTINCT v FROM dg ORDER BY v LIMIT 2 OFFSET 0"
"SELECT id FROM dg ORDER BY id DESC LIMIT 2"
"SELECT count(*) FROM pg_catalog.pg_class"
"SELECT c.relkind, count(*) FROM pg_catalog.pg_class c GROUP BY c.relkind ORDER BY c.relkind"
"SELECT n.nspname, count(*) FROM pg_catalog.pg_class c JOIN pg_catalog.pg_namespace n ON c.relnamespace = n.oid GROUP BY n.nspname ORDER BY n.nspname"
"SELECT v, count(*) FROM dg GROUP BY v ORDER BY v"
"SELECT relname FROM pg_catalog.pg_class WHERE relkind IN ('r', 'p') AND relname <> 'pg_class' ORDER BY relname"
"SELECT nspname FROM pg_catalog.pg_namespace WHERE nspname NOT LIKE 'pg_toast%' ORDER BY nspname"
"SELECT id FROM dg WHERE v <> 'two' ORDER BY id"
"SELECT id FROM dg WHERE v IN ('one', 'three') ORDER BY id"
"SELECT id FROM dg WHERE v LIKE '%o%' ORDER BY id"
"SELECT c.relname, n.nspname FROM pg_catalog.pg_class c LEFT JOIN pg_catalog.pg_namespace n ON c.relnamespace = n.oid ORDER BY 1, 2"
